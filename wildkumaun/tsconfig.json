{
  "compilerOptions": {
    "baseUrl": ".",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@payload-config": [
        "./src/payload.config.ts"
      ],
      // packages/payload-plugin-a11y is a sibling folder with no node_modules of
      // its own, and `payload` is a peer dependency it expects the host to
      // provide. TypeScript resolves the symlink to its real path and then looks
      // for the peer beside it, where there is nothing — so it is pointed here,
      // at the copy this site already has.
      "payload": [
        "./node_modules/payload"
      ],
      "@playwright/test": [
        "./node_modules/@playwright/test"
      ],
      "@axe-core/playwright": [
        "./node_modules/@axe-core/playwright"
      ]
    },
    "target": "ES2022"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
