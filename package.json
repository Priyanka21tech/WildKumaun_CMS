{
  "name": "wildkumaun",
  "version": "1.0.0",
  "private": true,
  "description": "Wild Kumaon — the mirrored site and Payload CMS, served by one Next.js app in wildkumaun/.",
  "scripts": {
    "dev": "npm --prefix wildkumaun run dev",
    "build": "npm --prefix wildkumaun run build",
    "start": "npm --prefix wildkumaun run start",
    "install:site": "npm --prefix wildkumaun install",
    "mirror:pages": "node _tools/build-mirror-pages.mjs",
    "mirror:scripts": "node _tools/fetch-scripts.mjs",
    "mirror:sync": "node _tools/sync-public.mjs",
    "mirror:media": "node _tools/sync-media.mjs",
    "mirror": "npm run mirror:pages && npm run mirror:sync && npm run mirror:media",
    "audit": "node _tools/audit-links.mjs"
  }
}
