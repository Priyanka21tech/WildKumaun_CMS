{
  "name": "wildkumaun",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "predev": "cross-env NODE_OPTIONS=--no-deprecation node --env-file=.env scripts/drop-orphan-columns.mjs && cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "reset:media": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/reset-media.ts",
    "import:media": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/import-media.ts",
    "seed:globals": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-globals.ts",
    "seed:faqs": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-faqs.ts",
    "seed:testimonials": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-testimonials.ts",
    "seed:posts": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-posts.ts",
    "seed:content": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-page-content.ts",
    "seed:amenities": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-amenities.ts",
    "seed:packages": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-packages.ts",
    "seed:birdart": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-bird-art.ts",
    "seed:blocks": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-page-blocks.ts",
    "fix:media-alt": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/fix-media-alt.ts",
    "check:wfh": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/check-wfh.ts",
    "check:targets": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/check-targets.ts",
    "fix:page-versions": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/backfill-page-versions.ts",
    "fix:nav": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/fix-nav-links.ts",
    "fix:link-text": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/fix-link-text.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/live-preview-react": "^3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-form-builder": "^3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
